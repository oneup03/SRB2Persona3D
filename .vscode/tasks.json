{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SRB2 Persona (Release)",
            "detail": "MSVC Win32 Release build, then stage exe + DLLs + game data into deploy\\Release",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build.ps1",
                "-Configuration", "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build SRB2 Persona (Debug)",
            "detail": "MSVC Win32 Debug build, then stage into deploy\\Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build.ps1",
                "-Configuration", "Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Rebuild SRB2 Persona (Release)",
            "detail": "Clean + full rebuild, then deploy",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build.ps1",
                "-Configuration", "Release",
                "-Rebuild"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build & Run SRB2 Persona",
            "detail": "Build + deploy, then launch the deployed game",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command",
                "& '${workspaceFolder}/build.ps1' -Configuration Release; if ($LASTEXITCODE -eq 0) { Start-Process -FilePath '${workspaceFolder}/deploy/Release/SRB2Persona.exe' -WorkingDirectory '${workspaceFolder}/deploy/Release' }"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
